# Copy to .env.local. Use the public client key, never a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase projects call this the publishable key; legacy projects call it the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: database integration tests only. Never prefix this with NEXT_PUBLIC_.
# Use only for a dedicated test project or the local Supabase stack.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: administrative database provisioning/CLI use only, not the web app.
# Store an actual generated password only in ignored .env.local or a secret manager.
SUPABASE_DB_PASSWORD=

# Optional: absolute public origin used in canonical, Open Graph, robots and sitemap metadata.
NEXT_PUBLIC_SITE_URL=https://void.pages.dev
